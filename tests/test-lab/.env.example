# Public stack configuration. Keep the real values in your shell, CI secret store,
# or Playwright project's secret configuration. Do not commit a populated file.
FENCE_TEST_SUPABASE_URL=https://<project-ref>.supabase.co
FENCE_TEST_SUPABASE_ANON_KEY=<public-anon-key>

# Public configuration for the Captain-created general GHL test pipeline.
GHL_TEST_PIPELINE_ID=kMSiJnd4KyPyIUletHbH
GHL_TEST_NEW_LEAD_STAGE_ID=61c23e36-8d28-4389-95f2-107f79173d6b

# Secret credentials for the seeded TEST-ZZZ Supabase Auth user.
FENCE_TEST_USER_EMAIL=<test-user-email>
FENCE_TEST_USER_PASSWORD=<test-user-password>

# Captain-approved team-owned sinks. The reset command refuses to run without
# both. They are written only to the TEST-ZZZ contact in the isolated pipeline.
FENCE_TEST_SINK_EMAIL=<team-owned-sink-email>
FENCE_TEST_SINK_PHONE=<team-owned-sink-phone-in-E.164>
FENCE_TEST_SINKS_APPROVED=YES-CAPTAIN-APPROVED

# Optional output consumed by Playwright. Default: .fence-test-lab-state.json
# FENCE_TEST_STATE_FILE=/absolute/path/to/fence-test-lab-state.json
